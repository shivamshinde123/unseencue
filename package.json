{
  "name": "unseencue",
  "productName": "Unseencue",
  "version": "0.3.0",
  "description": "Unseencue: a teleprompter that sits under your webcam and stays hidden from recordings and screen shares",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "Shivam Shinde",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "test": "node --test test/markdown.test.mjs test/voice.test.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "dist": "electron-builder --win",
    "icon": "node scripts/make-icon.mjs"
  },
  "build": {
    "appId": "local.unseencue",
    "productName": "Unseencue",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "models/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "publisherName": "Shivam Shinde"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Unseencue",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Unseencue-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Unseencue-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.21",
    "marked": "^14.1.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.5"
  }
}
